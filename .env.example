# JobFit Agent supports multiple LLM providers.
# Set the API key for ONE provider below — that provider is selected automatically.
# If several are set, detection order is: OpenAI > Anthropic > Gemini > Groq > Mistral.

OPENAI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here       # Claude (uses the official anthropic SDK)
# GEMINI_API_KEY=your-key-here          # Google Gemini
# GROQ_API_KEY=your-key-here            # Groq
# MISTRAL_API_KEY=your-key-here         # Mistral

# --- Optional overrides ------------------------------------------------------
# Force a specific provider regardless of which keys are set:
# LLM_PROVIDER=anthropic

# Override the model. A best-fit default is chosen per provider:
#   openai    -> gpt-4o
#   anthropic -> claude-opus-4-8
#   gemini    -> gemini-2.5-flash
#   groq      -> llama-3.3-70b-versatile
#   mistral   -> mistral-large-latest
# Global override (applies to whichever provider is active):
# LLM_MODEL=gpt-4o
# Per-provider override:
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-opus-4-8
# GEMINI_MODEL=gemini-3.1-flash-lite
# GROQ_MODEL=llama-3.3-70b-versatile
# MISTRAL_MODEL=mistral-large-latest

# Max output tokens (raise if responses get cut off; thinking models like
# Gemini 2.5 Flash spend part of the budget on internal reasoning):
# MAX_OUTPUT_TOKENS=4096
